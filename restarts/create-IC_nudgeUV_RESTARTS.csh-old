#! /bin/csh -fxv 

setenv CESM2_TOOLS_ROOT /glade/work/nanr/cesm_tags/CASE_tools/cesm2-LE-nudged-ERA5/

#setenv PINDIR /glade/derecho/scratch/nanr/CFSRv2/
setenv PINDIR /glade/campaign/cesm/development/espwg/SMYLE/initial_conditions/SMYLE-FOSI/rest/0327-01-01-00000
setenv CINDIR /glade/campaign/cgd/cas/islas/CESM_DATA/MAPP2023/f.e21.FHIST_BGC.f09_f09_mg17.historical_MAPPnudgeUV_6h_SPINUP.002/rest/1979-01-01-00000
/glade/work/nanr/CESM2-nudged-ERA5/inputdata/cesm2_init/b.e21.IC_nudgeUV.f09_g17.${year}-${mon}.01/${year}-${mon}-01/
setenv icdir /glade/work/nanr/CESM2-nudged-ERA5/inputdata/cesm2_init/b.e21.IC_nudgeUV.f09_g17.${year}-${mon}.01/${year}-${mon}-01/

setenv inpopname  g.e22.GOMIPECOIAF_JRA-1p4-2018.TL319_g17.SMYLE.005.${year}-${mon}.01.pop.r.${year}-${mon}-01-00000.cfsrv2.nc
setenv newpopname b.e21.IC_nudgeUV.f09_g17.${year}-${mon}.01.pop.r.${year}-${mon}-01-00000.nc

if (! -d ${icdir}) then
 mkdir -p ${icdir}
endif


set doThis=1
if (${doThis} == 1 ) then

# copy and rename other restart and pointer files
cp $CINDIR/b.e21.SMYLE_IC.f09_g17.${year}-${mon}.01.cam.i.${year}-${mon}-01-00000.nc $icdir/b.e21.SMYLE_IC_CFSRv2.f09_g17.${year}-${mon}.01.cam.i.${year}-${mon}-01-00000.nc
cp $CINDIR/b.e21.SMYLE_IC.f09_g17.${year}-${mon}.01.cice.r.${year}-${mon}-01-00000.nc $icdir/b.e21.SMYLE_IC_CFSRv2.f09_g17.${year}-${mon}.01.cice.r.${year}-${mon}-01-00000.nc
cp $CINDIR/b.e21.SMYLE_IC.f09_g17.${year}-${mon}.01.clm2.r.${year}-${mon}-01-00000.nc $icdir/b.e21.SMYLE_IC_CFSRv2.f09_g17.${year}-${mon}.01.clm2.r.${year}-${mon}-01-00000.nc
cp $CINDIR/b.e21.SMYLE_IC.f09_g17.${year}-${mon}.01.mosart.r.${year}-${mon}-01-00000.nc $icdir/b.e21.SMYLE_IC_CFSRv2.f09_g17.${year}-${mon}.01.mosart.r.${year}-${mon}-01-00000.nc
cp $CINDIR/b.e21.SMYLE_IC.f09_g17.${year}-${mon}.01.pop.rh.ecosys.nyear1.${year}-${mon}-01-00000.nc $icdir/b.e21.SMYLE_IC_CFSRv2.f09_g17.${year}-${mon}.01.pop.rh.ecosys.nyear1.${year}-${mon}-01-00000.nc
cp $CINDIR/b.e21.SMYLE_IC.f09_g17.${year}-${mon}.01.pop.ro.${year}-${mon}-01-00000 $icdir/b.e21.SMYLE_IC_CFSRv2.f09_g17.${year}-${mon}.01.pop.ro.${year}-${mon}-01-00000
cp $CINDIR/b.e21.SMYLE_IC.f09_g17.${year}-${mon}.01.ww3.r.${year}-${mon}-01-00000 $icdir/b.e21.SMYLE_IC_CFSRv2.f09_g17.${year}-${mon}.01.ww3.r.${year}-${mon}-01-00000

# copy new pop restart file
echo $newpopname
cp $PINDIR/$inpopname $icdir/$newpopname

# create rpointer files
set case=b.e21.SMYLE_IC_CFSRv2.f09_g17.${year}-${mon}.01

echo "$case.cice.r.$year-${mon}-01-00000.nc"  > ${icdir}/rpointer.ice
echo "./$case.pop.ro.$year-${mon}-01-00000"   > ${icdir}/rpointer.ocn.ovf
echo "$case.cam.r.$year-${mon}-01-00000.nc"   > ${icdir}/rpointer.atm
echo "$case.cpl.r.$year-${mon}-01-00000.nc"   > ${icdir}/rpointer.drv
echo "$case.clm2.r.$year-${mon}-01-00000.nc"  > ${icdir}/rpointer.lnd
echo "$case.mosart.r.$year-${mon}-01-00000.nc"   > ${icdir}/rpointer.rof
echo "$case.pop.rh.ecosys.nyear1.$year-${mon}-01-00000.nc"   > ${icdir}/rpointer.ocn.tavg.5
echo "$case.pop.rh.$year-${mon}-01-00000.nc"   > ${icdir}/rpointer.ocn.tavg

echo "./$case.pop.r.$year-${mon}-01-00000.nc"    >> ${icdir}/rpointer.ocn.restart
echo "RESTART_FMT=nc"                          >> ${icdir}/rpointer.ocn.restart

ncatted -h -a history,global,o,c,"Modified with CFSRv2.  patched: TEMP_CUR, TEMP_OLD, SALT_CUR, SALT_OLD. Zeroed velocity fields: UVEL_CUR, UVEL_OLD, VVEL_CUR, VVEL_OLD, UBTROP_CUR, UBTROP_OLD, VBTROP_CUR, VBTROP_OLD" $icdir/$newpopname

endif

# ==================================
# generate perturbed cam.i.restarts
# ==================================
setenv CYLC_TASK_CYCLE_POINT ${year}-${mon}-01
cd ${CESM2_TOOLS_ROOT}/restarts/
./generate_cami_ensemble_offline.CFSRv2.py



end
end

exit
 
 



