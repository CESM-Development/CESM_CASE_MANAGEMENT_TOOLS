#!/bin/csh -f
### set env variables

set COMPSET = E1850C5
set EXPERIMENT = capt-SOM
set RESOLN  = ne120_t12
set MACHINE = cheyenne
set TAG     = cesm-ihesp-hires1.0.35
set PROJECT = P93300313

set mbr = 4
setenv CASE e.e13.${COMPSET}.${RESOLN}.${TAG}.${EXPERIMENT}.0${mbr}

set PATH      = /glade/work/nanr/
set RUNDIR    = /glade/scratch/nanr/$CASE/run
set TOOLS     = /glade/work/nanr/cesm_tags/CASE_tools/
setenv CASEROOT /glade/work/nanr/capt/cases/$CASE
setenv CESMROOT /glade/work/nanr/cesm_tags/cesm-ihesp-hires1.0.35

set TOOLSROOT = $TOOLS/cesm1-capt/

$CESMROOT/cime/scripts/create_newcase --case $CASEROOT --res $RESOLN  --mach $MACHINE --compset $COMPSET --run-unsupported

cd $CASEROOT

### modify case parameters
./xmlchange RUN_TYPE=hybrid
./xmlchange RUN_STARTDATE=2010-01-05
./xmlchange RUN_REFDATE=2010-01-05
./xmlchange STOP_OPTION=ndays
./xmlchange STOP_N=90

./xmlchange DOCN_SOM_FILENAME=pop.frc.g.e21.GIAF.TL319_t13.5thCyc.ice.001_c20210628.nc
./xmlchange ATM_DOMAIN_FILE=domain.lnd.ne120np4_tx0.1v2.210621.nc
./xmlchange LND_DOMAIN_FILE=domain.lnd.ne120np4_tx0.1v2.210621.nc
./xmlchange ICE_DOMAIN_FILE=domain.ocn.tx0.1v2.210621.nc
./xmlchange OCN_DOMAIN_FILE=domain.ocn.tx0.1v2.210621.nc
./xmlchange NTASKS_CPL=7200
./xmlchange NTASKS_ATM=7200
./xmlchange NTASKS_LND=1200
./xmlchange NTASKS_ICE=6000
./xmlchange ROOTPE_ICE=1200
./xmlchange NTASKS_OCN=2135
./xmlchange ROOTPE_OCN=7200
./xmlchange NTASKS_ROF=1200
./xmlchange NTASKS_GLC=1
./xmlchange NTASKS_WAV=1

./xmlchange ATM_NCPL=96
./xmlchange OCN_NCPL=96
./xmlchange ROF_NCPL=96
./xmlchange CAM_NAMELIST_OPTS='irad_always=-1'

### call cesm_setup and create user namelists
./case.setup

###  Add new variables
cp user_nl_cam user_nl_cam.output.`date +%m%d-%H%M`
cat > user_nl_cam <<EOF
!CASE_DESC           = 'f.e13.FRCP85C5.ne120_t12.sehires32.capt.0${mbr}'
!ncdata              = '/global/cscratch1/sd/nanr/capt-prediction/atm/ERA5/regridded/hannay_ERA5_IC_ne120_L30/hannay_ERA5_IC_ne120_L30.cam2.i.2010-01-05-00000.nc'
 ncdata              = '/glade/scratch/nanr/CAPT/hannay_ERA5_IC_ne120_L30.cam2.i.2010-01-05-00000.nc'
 dust_emis_fact      = 1.05D0
 zmconv_c0_lnd       =  0.0059D0
 zmconv_c0_ocn       =  0.0450D0
 micro_mg_dcs        =  600.D-6
 cldfrc_rhminl       =  0.95D0
 se_nsplit           =  4
 se_ftype            =  2
EOF

mv user_nl_clm user_nl_clm.`date +%m%d-%H%M`
cat >> user_nl_clm << EOF
 finidat = '/glade/scratch/nanr/CAPT/i.e13.ICRUCN.ne120_t12.2009-2016.001.clm2.r.2010-05-01-00000.nc'
 fsurdat = '/glade/p/cesmdata/cseg/inputdata/lnd/clm2/surfdata_map/surfdata_ne120np4_simyr2000_c130313.nc'

EOF

mv user_nl_rtm user_nl_rtm.`date +%m%d-%H%M`
cat >> user_nl_rtm << EOF
 finidat_rtm = '/glade/scratch/nanr/CAPT/i.e13.ICRUCN.ne120_ne120.2009-2016.001.rtm.r.2010-01-05-00000.nc'
EOF



qcmd -- ./case.build
exit
