#!/bin/csh -f

set NANPATH = /glade/work/nanr/
set TOOLS   = /glade/work/nanr/cesm_tags/CASE_tools/ihesp-tools/
set COMPSET = BHISTC5
set RESOLN  = ne120_t12
set MACHINE = derecho
set TAG     = cesm-ihesp-hires1.0.46
setenv CESMROOT ${NANPATH}/cesm_tags/sandbox/${TAG}/

set mbr = 10
setenv CASE b.e13.${COMPSET}.${RESOLN}.${TAG}-1920-2005.hfreq.0${mbr}
setenv CASEROOT /glade/work/$USER/ihesp-HiRes/cases/ne120_t12/$CASE
set RUNDIR   = /glade/derecho/scratch/$USER/$CASE/run

echo $RUNDIR

$CESMROOT/cime/scripts/create_newcase --case $CASEROOT --res $RESOLN  --mach $MACHINE --compset $COMPSET --pecount L --run-unsupported

cd $CASEROOT

./xmlchange NTASKS_CPL=10240
./xmlchange NTASKS_ATM=10240
./xmlchange NTASKS_LND=1280
./xmlchange NTASKS_ICE=8960
./xmlchange ROOTPE_ICE=1280
./xmlchange NTASKS_OCN=3840
./xmlchange ROOTPE_OCN=10240
./xmlchange NTASKS_ROF=1280
./xmlchange NTASKS_GLC=1
./xmlchange NTASKS_WAV=1

./xmlchange RUN_REFCASE=b.e13.BHISTC5.ne120_t12.cesm-ihesp-hires1.0.46-1920-2005.010/
./xmlchange RUN_REFDATE=2000-01-01
./xmlchange RUN_STARTDATE=2000-01-01
./xmlchange RUN_TYPE=branch
./xmlchange GET_REFCASE=FALSE
./xmlchange STOP_OPTION=nyears
./xmlchange STOP_N=1
./xmlchange RESUBMIT=10
./xmlchange DOUT_S_SAVE_INTERIM_RESTART_FILES=TRUE
./xmlchange REST_N=1
./xmlchange REST_OPTION=nyears
./xmlchange REST_OPTION=nyears

./xmlchange --append CAM_CONFIG_OPTS=-cosp
./xmlchange JOB_WALLCLOCK_TIME=12:00:00 --subgroup case.run

cp $TOOLS/user_nl_files/BHIST-hfreq/* $CASEROOT/
cp $TOOLS/SourceMods/src.pop/*  $CASEROOT/SourceMods/src.pop/


./case.setup --reset
./xmlchange EXEROOT=XXXXXXXXXPATH
./xmlchange BUILD_COMPLETE=TRUE
./xmlchange CONTINUE_RUN=TRUE
