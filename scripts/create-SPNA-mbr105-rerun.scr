#!/bin/csh -f

set MACHINE = derecho
set TOOLS_ROOT = /glade/work/nanr/cesm_tags/CASE_tools/cesm13-SPNA-HR/

set COMPSET = B1950C5 
set EXPERIMENT = SPNA-derecho
set RESOLN  = ne120_t12
set TAG     = cesm-ihesp-hires1.0.46

#set RESUBMIT = 1
#set STOP_OPTION=nmonths
#set STOP_N=31
set RESUBMIT = 0
set STOP_OPTION=nmonths
set STOP_N=6
set REST_OPTION=nmonths
set REST_N=6

# ls /glade/campaign/collections/cmip/CMIP6/iHESP/PIcntl/HR/B.E.13.B1850C5.ne120_t12.sehires38.003.sunway_02/restart/
# ls /glade/campaign/collections/cmip/CMIP6/iHESP/HighResMIP/B1950cntl/HR/restarts

#  Here are the starts.  I can start with the first 5 starts (89, 96, 100, 105, 112) if that sounds good to you.
#  0089-01-01-00000/
#  0096-01-01-00000/
#  0100-01-01-00000/
#  0105-01-01-00000/
#  0112-01-01-00000/
#  0115-01-01-00000/
#  0117-01-01-00000/
#  0119-01-01-00000/
#  0121-01-01-00000/
#  0130-01-01-00000/

#set syear =  89
#set eyear =  89
#set syear =  96
#set eyear =  96
#set syear =  100
#set eyear =  100
set syear =  105
set eyear =  105
#set syear =  115
#set eyear =  115
#set syear =  112
#set eyear =  112
#set syear =  119 ==> remap errors
#set eyear =  119 ==> remap errors
#set syear =  117
#set eyear =  117
set year = $syear
if ($year < 100) then
  set useyear = "00"${year}
else
  set useyear = "0"${year}
endif

set restartyear = "0110"

if ($year < 100) then
	setenv CASE b.e13.${EXPERIMENT}.${RESOLN}.SY-0${year}.001
else
	setenv CASE b.e13.${EXPERIMENT}.${RESOLN}.SY-${year}.001
endif

setenv REFCASE B.E.13.B1950C5.ne120_t12.cesm-ihesp-1950cntl.013

set PATH      = /glade/work/nanr/
set RUNDIR    = /glade/derecho/scratch/nanr/$CASE/run
set BLDDIR    = /glade/derecho/scratch/nanr/$CASE/bld
setenv CASEROOT /glade/work/nanr/SPNA-HR/cases/rerun/$CASE
set TOOLSROOT = /glade/work/nanr/cesm_tags/CASE_tools/cesm13-SPNA-HR/
set REFROOT   = /glade/derecho/scratch/nanr/archive/b.e13.SPNA-derecho.ne120_t12.SY-105.001/

# setenv CESMROOT ${PATH}/cesm_tags/sandbox/${TAG}/
setenv CESMROOT ${PATH}/cesm_tags/${TAG}/


$CESMROOT/cime/scripts/create_newcase --case $CASEROOT --res $RESOLN  --mach $MACHINE --compset $COMPSET --pecount L2 --run-unsupported 

cd $CASEROOT

# cp /glade/derecho/scratch/jedwards/PFS.ne120_t12.B1850C5.derecho_intel.20230713_142721_f6jwlw/env_mach_pes.xml $CASEROOT
# cp $TOOLS_ROOT/pelayout/env_mach_pes.xml.417nodes $CASEROOT/env_mach_pes.xml
cp $TOOLS_ROOT/pelayout/env_mach_pes.xml.110nodes $CASEROOT/env_mach_pes.xml

./xmlchange DOUT_S_SAVE_INTERIM_RESTART_FILES=TRUE 
./xmlchange JOB_WALLCLOCK_TIME=12:00:00 --subgroup case.run
./xmlchange JOB_WALLCLOCK_TIME=00:30:00 --subgroup case.st_archive
#./xmlchange MPIRUN_RETRY_COUNT=4,MPIRUN_RETRY_REGEX="Resource temporarily unavailable"
./xmlchange PIO_VERSION=1
./xmlchange RESUBMIT=$RESUBMIT
./xmlchange STOP_OPTION=$STOP_OPTION
./xmlchange STOP_N=$STOP_N
./xmlchange RUN_TYPE=hybrid
./xmlchange RUN_STARTDATE=${useyear}-01-01
./xmlchange RUN_REFCASE=${REFCASE}
./xmlchange RUN_REFDATE=${useyear}-01-01
./xmlchange GET_REFCASE=FALSE
./xmlchange OCN_TRACER_MODULES=""
./xmlchange RUN_REFDIR=${REFROOT}
##./xmlchange --append CAM_CONFIG_OPTS=-cosp

./xmlchange PROJECT=CESM0021
#./xmlchange JOB_QUEUE= --subgroup case.run

##cp $TOOLSROOT/user_nl_files/DP-HR/user_nl_cam-COSP-ON $CASEROOT/user_nl_cam
cp $TOOLSROOT/user_nl_files/1950-derecho/user_nl_cam $CASEROOT/user_nl_cam
cp $TOOLSROOT/user_nl_files/1950-derecho/user_nl_clm $CASEROOT/user_nl_clm
cp $TOOLSROOT/user_nl_files/1950-derecho/user_nl_cice $CASEROOT/user_nl_cice
cp $TOOLSROOT/user_nl_files/1950-derecho/user_nl_rtm $CASEROOT/user_nl_rtm

cp $TOOLSROOT/SourceMods/src.pop/BSPNA_HR/*  $CASEROOT/SourceMods/src.pop/
cp $TOOLSROOT/SourceMods/src.cam/*F90  $CASEROOT/SourceMods/src.cam/


if (! -d $RUNDIR) then
 mkdir -p $RUNDIR
endif

echo "================="
echo $REFROOT/rest/${restartyear}-01-01-00000/
echo "================="
echo    $REFROOT/rest/${restartyear}-01-01-00000/rpoint* 
cp    $REFROOT/rest/${restartyear}-01-01-00000/rpoint* $RUNDIR
ln -s $REFROOT/rest/${restartyear}-01-01-00000/b.e* $RUNDIR

./case.setup

./case.setup --reset
./xmlchange BUILD_COMPLETE=TRUE
./xmlchange EXEROOT=/glade/derecho/scratch/nanr/b.e13.SPNA-derecho.ne120_t12.SY-119.001/bld/
./xmlchange CONTINUE_RUN=TRUE

#qcmd -A ACGD0008 -- ./case.build
#qcmd -A P93300313 -- ./case.build

