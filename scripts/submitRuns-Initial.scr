#!/bin/csh -fx
### set env variables
setenv CESM2_LE_TOOLS_ROOT /glade/work/nanr/cesm_tags/CASE_tools/cesm2-covid/

set COMPSET = BSSP245cmip6
set SIMULAT = COVID-gfed-2015-2020
set MACHINE = cheyenne
set RESOLN = f09_g17

setenv BASEROOT /glade/work/nanr/CESM2-covid/


# now create cases

set smbr =  1
set embr =  10

@ mb = $smbr
@ me = $embr

foreach mbr ( `seq $mb  $me` )

if    ($mbr < 10) then
        setenv CASENAME b.e21.BSSP245cmip6.f09_g17.COVID-cvd-aufire-shipping.10${mbr}
        #setenv CASENAME b.e21.BSSP245cmip6.f09_g17.COVID-cvd-aufire-shipping-0.2.10${mbr}
        #setenv CASENAME b.e21.BSSP245cmip6.f09_g17.COVID-cvd-aufire-derecho.10${mbr}
else if ($mbr >= 10 && $mbr < 100) then
        setenv CASENAME b.e21.BSSP245cmip6.f09_g17.COVID-cvd-aufire-shipping.1${mbr}
        #setenv CASENAME b.e21.BSSP245cmip6.f09_g17.COVID-cvd-aufire-shipping-0.2.1${mbr}
        #setenv CASENAME b.e21.BSSP245cmip6.f09_g17.COVID-cvd-aufire-derecho.1${mbr}
endif

  setenv CASEROOT  $BASEROOT$CASENAME

  cd $CASEROOT

  #./case.setup --reset
  #./xmlchange STOP_N=36,REST_N=36,RESUBMIT=0
  #./xmlchange STOP_N=12,REST_N=12,RESUBMIT=0
  ./case.submit

end             # member loop

exit

